# ==============================================================================
# FISHING TRACKER - Variáveis de Ambiente (Exemplo)
# Copie este arquivo para `.env` e preencha suas chaves reais.
# NUNCA suba o arquivo `.env` para o GitHub!
# ==============================================================================

# Chave gratuita da API v3 do VirusTotal (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=sua_chave_do_virustotal_aqui

# Timeout padrão (em segundos) para consultas externas (VirusTotal, DNS, WHOIS)
REQUEST_TIMEOUT_SECONDS=10

# Habilitar checagem ativa de DNS/WHOIS em tempo de execução (true/false)
ENABLE_DNS_WHOIS_LOOKUP=false
